<?xml version="1.0"?>
<rdf:RDF xmlns="http://ontology.holywells.link/ontology/"
     xml:base="http://ontology.holywells.link/ontology/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:wdP="http://www.wikidata.org/prop/direct/"
     xmlns:wdQ="http://www.wikidata.org/entity/"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:CRMgeo="http://www.ics.forth.gr/isl/CRMgeo/"
     xmlns:schema="http://schema.org/"
     xmlns:cidoc-crm="http://www.cidoc-crm.org/cidoc-crm/">
    <owl:Ontology rdf:about="http://ontology.holywells.link/ontology">
        <owl:imports rdf:resource="http://www.cidoc-crm.org/cidoc-crm/"/>
        <owl:imports rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
        <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://schema.org/description -->

    <owl:AnnotationProperty rdf:about="http://schema.org/description"/>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P87i_identifies -->

    <owl:AnnotationProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P87i_identifies"/>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q10_defines_place -->

    <owl:AnnotationProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q10_defines_place">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P87i_identifies"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP6_Declarative_Place"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://ontology.holywells.link/ontology/object -->

    <owl:ObjectProperty rdf:about="http://ontology.holywells.link/ontology/object">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P67_refers_to"/>
    </owl:ObjectProperty>
    


    <!-- http://ontology.holywells.link/ontology/predicate -->

    <owl:ObjectProperty rdf:about="http://ontology.holywells.link/ontology/predicate">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P67_refers_to"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q10_defines_place -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q10_defines_place">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP5_Geometric_Place_Expression"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q10i_place_is_defined_by -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q10i_place_is_defined_by">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP6_Declarative_Place"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP5_Geometric_Place_Expression"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q11_approximates -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q11_approximates">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P121_overlaps_with"/>
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP6_Declarative_Place"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E53_Place"/>
        <rdfs:comment>Scope note:	This property approximates a phenomenal place which is defined in the same reference space. The property does not state the quality or accuracy of the approximation, but an overlap in area is the minimal requirement.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q11i_is_approximated_by -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q11i_is_approximated_by">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P121_overlaps_with"/>
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E53_Place"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP6_Declarative_Place"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q12_approximates -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q12_approximates">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP7_Declarative_Spacetime_Volume"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E92_Spacetime_Volume"/>
        <rdfs:comment>Scope note:	This property approximates a SP8 Spacetime Volume. The property does not state the quality or accuracy of the approximation, but an overlap of the spacetime volume is the minimal requirement.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q12i_approximates -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q12i_approximates">
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E92_Spacetime_Volume"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP7_Declarative_Spacetime_Volume"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q13_approximates -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q13_approximates">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP10_Declarative_Time-Span"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
        <rdfs:comment>Scope note:	This property approximates a SP9 Time Intervall. The property does not state the quality or accuracy of the approximation, but an overlap in time is the minimal requirement.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q13i_approximates -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q13i_approximates">
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP10_Declarative_Time-Span"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q14_defines_time -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q14_defines_time">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP14_Time_Expression"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP10_Declarative_Time-Span"/>
        <rdfs:comment>Scope note:	This property associates an instance of SP14 Time Expression with the instance of SP10 Declarative Time Span it defines. Syntactic variants or use of different scripts may result in multiple instances of SP14 Time Expression defining exactly the same time span. Transformations between different temporal reference systems in general result in new definitions of time spans approximating each other.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q14i_defines_time -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q14i_defines_time">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP10_Declarative_Time-Span"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP14_Time_Expression"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q15_is_expressed_in_terms_of -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q15_is_expressed_in_terms_of">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP14_Time_Expression"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP11_Temporal_Reference_System"/>
        <rdfs:comment>Scope note:	This property defines the temporal reference system in terms of which an SP14 Time Expression is formulated.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q15i_is_expressed_in_terms_of -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q15i_is_expressed_in_terms_of">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP11_Temporal_Reference_System"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP14_Time_Expression"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q16_defines_spacetime_volume -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q16_defines_spacetime_volume">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP12_Spacetime_Volume_Expression"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP7_Declarative_Spacetime_Volume"/>
        <rdfs:comment>Scope note:	This property associates an instance of SP12 Spacetime Volume Expression with the instance of SP7 Declarative Spacetime Volume it defines. Syntactic variants or use of different scripts may result in multiple instances of SP12 Spacetime Volume Expressions defining exactly the same SP7 Declarative Spacetime Volume. Transformations between different temporal or spatial reference systems in general result in new definitions of Spacetime Volumes approximating each other.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q16i_defines_spacetime_volume -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q16i_defines_spacetime_volume">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP7_Declarative_Spacetime_Volume"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP12_Spacetime_Volume_Expression"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q17_is_expressed_in_terms_of -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q17_is_expressed_in_terms_of">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP12_Spacetime_Volume_Expression"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP11_Temporal_Reference_System"/>
        <rdfs:comment>Scope note:	This property defines the temporal reference system in terms of which a SP12 Spacetime Volume Expression is formulated.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q17i_is_expressed_in_terms_of -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q17i_is_expressed_in_terms_of">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP11_Temporal_Reference_System"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP12_Spacetime_Volume_Expression"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q18_is_expressed_in_terms_of -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q18_is_expressed_in_terms_of">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP12_Spacetime_Volume_Expression"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP4_Spatial_Coordinate_Reference_System"/>
        <rdfs:comment>Scope note:	This property defines the spatial coordinate reference system in terms of which a SP12 Spacetime Volume Expression is formulated.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q18i_is_expressed_in_terms_of -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q18i_is_expressed_in_terms_of">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP4_Spatial_Coordinate_Reference_System"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP12_Spacetime_Volume_Expression"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q19_has_reference_event -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q19_has_reference_event">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP11_Temporal_Reference_System"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E5_Event"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q19i_has_reference_event -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q19i_has_reference_event">
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E5_Event"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP11_Temporal_Reference_System"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q1_occupied -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q1_occupied">
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E4_Period"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP1_Phenomenal_Spacetime_Volume"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q1i_is_occupied_by -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q1i_is_occupied_by">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP1_Phenomenal_Spacetime_Volume"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E4_Period"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q2_occupied -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q2_occupied">
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP1_Phenomenal_Spacetime_Volume"/>
        <rdfs:comment>Scope note:	This property describes the 4 dimensional point sets (volumes) in spacetime that the trajectory of an instance of E18 Physical Thing occupies in spacetime in the course of its existence. We include in the occupied space the space filled by the matter of the physical thing and all inner spaces not accessible in regular function.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q2i_is_occupied_by -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q2i_is_occupied_by">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP1_Phenomenal_Spacetime_Volume"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q3_has_temporal_projection -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q3_has_temporal_projection">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP1_Phenomenal_Spacetime_Volume"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP13_Phenomenal_Time-Span"/>
        <rdfs:comment>Scope note: 	This property describes the temporal projection of an instance of a SP1 Phenomenal Spacetime Volume. The property P4 has time-span is a shortcut of the more fully developed path from E4 Period through Q1 occupied, SP1 Phenomenal Spacetime Volume Q3 has temporal projection to E52 Time Span.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q3i_is_temporal_projection -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q3i_is_temporal_projection">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP13_Phenomenal_Time-Span"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP1_Phenomenal_Spacetime_Volume"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q4_has_spatial_projection -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q4_has_spatial_projection">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP1_Phenomenal_Spacetime_Volume"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP2_Phenomenal_Place"/>
        <rdfs:comment>Scope note:	This property describes the spatial projection of an instance of a SP1 Phenomenal Spacetime Volume on an instance of SP2 Phenomenal Place. Even though the projection of a spacetime volume to one instance of SP3 Reference Space is unique, each reference space gives rise to another projection. The projections overlap at the time of the spacetime volume, the respective instances of SP2 Phenomenal Place may later drift apart, or earlier be yet apart.
The property P7 took place at is a shortcut of the more fully developed path from E4 Period through Q1 occupied, SP1 Phenomenal Spacetime Volume Q4 has spatial projection to SP2 Phenomenal Place.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q4i_is_spatial_projection -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q4i_is_spatial_projection">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP2_Phenomenal_Place"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP1_Phenomenal_Spacetime_Volume"/>
        <rdfs:comment>i of</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q5_defined_in -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q5_defined_in">
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E53_Place"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP3_Reference_Space"/>
        <rdfs:comment>Scope note:	This property associates an instance of  E53 Place with the instance of  SP3 Reference Space it is defined in.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q5i_defined_in -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q5i_defined_in">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP3_Reference_Space"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E53_Place"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q6_is_at_rest_in_relation_to -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q6_is_at_rest_in_relation_to">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP3_Reference_Space"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q6i_rests_in_relation_to -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q6i_rests_in_relation_to">
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP3_Reference_Space"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q7_describes -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q7_describes">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP4_Spatial_Coordinate_Reference_System"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP3_Reference_Space"/>
        <rdfs:comment>Scope note:	This property associates an instance of SP4 Spatial Coordinate Reference System with the instance of SP3 Reference Space for which it can be used to describe locations.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q7i_is_described_by -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q7i_is_described_by">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP3_Reference_Space"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP4_Spatial_Coordinate_Reference_System"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q8_is_fixed_on -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q8_is_fixed_on">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP4_Spatial_Coordinate_Reference_System"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E26_Physical_Feature"/>
        <rdfs:comment>Scope note:	This property defines the physical reference features that ground a spatial coordinate reference system in the real world. 
In surveying and geodesy this is part of the datum definition and is often a point identified by a physical feature on earth (sometimes monuments) where the earth approximation ellipsoid touches the earth and one axis of the ellipsoid runs through.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q8i_fixes -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q8i_fixes">
        <rdfs:domain rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E26_Physical_Feature"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP4_Spatial_Coordinate_Reference_System"/>
    </owl:ObjectProperty>
    


    <!-- http://www.ics.forth.gr/isl/CRMgeo/Q9_is_expressed_in_terms_of -->

    <owl:ObjectProperty rdf:about="http://www.ics.forth.gr/isl/CRMgeo/Q9_is_expressed_in_terms_of">
        <rdfs:domain rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP5_Geometric_Place_Expression"/>
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMgeo/SP4_Spatial_Coordinate_Reference_System"/>
        <rdfs:comment>Scope note:	This property defines the coordinate reference system in terms of which a geometric place expression is formulated.</rdfs:comment>
