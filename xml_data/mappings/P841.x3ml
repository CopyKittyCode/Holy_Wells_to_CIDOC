<?xml version="1.0" encoding="UTF-8"?>

<x3ml version="1.0" source_type="xpath">

	<namespaces>

		<namespace prefix="hw"
			uri="http://ontology.holywells.link/ontology/" />

		<namespace prefix="crm"
			uri="http://www.cidoc-crm.org/cidoc-crm/" />

		<namespace prefix="owl"
			uri="http://www.w3.org/2002/07/owl#" />

		<namespace prefix="rdf"
			uri="http://www.w3.org/1999/02/22-rdf-syntax-ns#" />

		<namespace prefix="rdfs"
			uri="http://www.w3.org/2000/01/rdf-schema#" />

		<namespace prefix="skos"
			uri="http://www.w3.org/2004/02/skos/core#" />

		<namespace prefix="schema"
			uri="http://schema.org/" />

		<namespace prefix="xsd"
			uri="http://www.w3.org/2001/XMLSchema#" />

		<namespace prefix="time"
			uri="http://www.w3.org/2006/time#" />

	</namespaces>

	<mappings>
		<!-- ===================================================== -->
		<!-- E7_Activity wd:Q-code -->
		<!-- E7_Activity -> P4_has_time-span -> Feast_Day_Columba -->
		<!-- Feast_Day_Columba -> time:hasDateTimeDescription -> June9_Pattern-->
		<!-- June9_Pattern http://www.w3.org/2006/time#day 9 Generalized day-->
		<!-- June9_Pattern http://www.w3.org/2006/time#month 6 Generalized month-->
		<!-- ===================================================== -->
		<mapping>

			<domain>

				<source_node>
					//*[local-name()='binding' and @name='object']
				</source_node>

				<target_node>

					<entity>

						<type>crm:E7_Activity</type>
						<!--E7_Activity_SubjectQcode_ObjectQcode-->
						<instance_generator name="URIorUUID">
							<arg name="text" type="xpath">
								concat('http://ontology.holywells.link/ontology/E7_Activity_',
								substring-after(../*[local-name()='binding' and
								@name='subject']/*[local-name()='uri']/text(),
								'http://www.wikidata.org/entity/'),
								'_',
								substring-after(
								../*[local-name()='binding' and @name='object']
								/*[local-name()='uri']/text(), 'http://www.wikidata.org/entity/'))
							</arg>
						</instance_generator>

						<!-- E7_Activity -> P4_has_time-span -> Feast_Day_Columba -->
						<additional>

							<relationship>crm:P4_has_time-span</relationship>

							<entity>

								<type>crm:E52_Time-Span</type>
								<instance_generator name="URIorUUID">
									<arg name="text" type="xpath">
										concat('http://ontology.holywells.link/ontology/Feast_Day_',
										substring-after(../*[local-name()='binding' and
										@name='object']/*[local-name()='uri']/text(),
										'http://www.wikidata.org/entity/'))
									</arg>
								</instance_generator>

								<label_generator name="SimpleLabel">
									<arg name="label" type="xpath">
										concat('E52_Time-Span_Feast_Day_',
										substring-after(../*[local-name()='binding' and
										@name='object']/*[local-name()='uri']/text(),
										'http://www.wikidata.org/entity/'))

									</arg>

									<arg name="language" type="constant">en</arg>
								</label_generator>



								<!-- Feast_Day_Columba -> time:hasDateTimeDescription ->
								June9_Pattern-->

								<additional>
									<relationship>time:hasDateTimeDescription</relationship>
									<entity>
										<type>time:Generalized_date-time_description</type>


										<instance_generator name="ConcatString">
											<arg name="prefix" type="constant">
												http://ontology.holywells.link/ontology/Time_Pattern_
											</arg>

											<arg name="text" type="xpath">
												../*[local-name()='binding' and @name='objectLabel']
												/*[local-name()='literal']/text()

											</arg>

											<arg name="sameTermsDelim" type="constant">
												_
											</arg>

											<arg name="diffTermsDelim" type="constant">
												_
											</arg>
										</instance_generator>

									</entity>

								</additional>

							</entity>

						</additional>

						<!-- E7_Activity -> P17_was_motivatd_by -> holy well-->
						<additional>

							<relationship>crm:P4_has_time-span</relationship>

							<entity>

								<type>owl:NamedIndividual</type>
								<instance_generator name="URIorUUID">
									<arg name="text" type="xpath">
										../*[local-name()='binding' and
										@name='subject']/*[local-name()='uri']/text()
									</arg>
								</instance_generator>

							</entity>
						</additional>


					</entity>

				</target_node>

			</domain>

		</mapping>

		<!-- ===================================================== -->
		<!-- wikidata document -> P67_refers_to -> E7_Activity -->
		<!-- ===================================================== -->

		<mapping>

			<domain>

				<source_node>
					//*[local-name()='binding' and @name='statedIn']
				</source_node>

				<target_node>
					<!-- Create individual for the document -->
					<entity>

						<type>owl:NamedIndividual</type>

						<instance_generator name="URIorUUID">
							<arg name="text" type="xpath">
								../*[local-name()='binding' and
								@name='statedIn']/*[local-name()='uri']/text()
							</arg>
						</instance_generator>

						<label_generator name="SimpleLabel">
							<arg name="label" type="xpath">
								../*[local-name()='binding' and @name='statedInLabel']
								/*[local-name()='literal' and @xml:lang ='en']/text(),
								&quot;'&quot;
							</arg>

							<arg name="language" type="constant">en</arg>

						</label_generator>

						<!-- wikidata document -> P67_refers_to -> E17 -->
						<additional>
							<relationship>crm:P67_refers_to</relationship>
							<entity>

								<type>crm:E7_Activity</type>
								<!--E7_Activity_SubjectQcode_ObjectQcode-->
								<instance_generator name="URIorUUID">
									<arg name="text" type="xpath">
										concat('http://ontology.holywells.link/ontology/E7_Activity_',
										substring-after(../*[local-name()='binding' and
										@name='subject']/*[local-name()='uri']/text(),
										'http://www.wikidata.org/entity/'),
										'_',
										substring-after(
										../*[local-name()='binding' and @name='object']
										/*[local-name()='uri']/text(),
										'http://www.wikidata.org/entity/'))
									</arg>
								</instance_generator>
							</entity>
						</additional>

					</entity>

				</target_node>

			</domain>

		</mapping>



		<!-- ===================================================== -->
		<!-- wikidata document rdfs type stated by wikidata -->
		<!-- ===================================================== -->

		<mapping>
			<domain>
				<source_node>
					//*[local-name()='binding' and @name='statedInInstanceOfLabel']
				</source_node>

				<target_node>

					<entity>

						<type>owl:NamedIndividual</type>

						<instance_generator name="URIorUUID">
							<arg name="text" type="xpath">
								../*[local-name()='binding' and
								@name='statedIn']/*[local-name()='uri']/text()
							</arg>
						</instance_generator>

						<additional>

							<relationship>rdf:type</relationship>

							<entity>
								<type>owl:Class</type>

								<instance_generator name="CapitalizeWords">

									<arg name="prefix" type="constant">
										http://ontology.holywells.link/ontology/
									</arg>

									<arg name="text" type="xpath">
										./*[local-name()='literal']/text()
									</arg>
								</instance_generator>
							</entity>
						</additional>
					</entity>
				</target_node>
			</domain>
		</mapping>

		<!-- ===================================================== -->
		<!-- types stated by wikidata rdf:subclass E73_Information_Object -->
		<!-- ===================================================== -->

		<mapping>
			<domain>
				<source_node>
					//*[local-name()='result'][
					*[local-name()='binding' and @name='statedInInstanceOfLabel']
					]
				</source_node>

				<target_node>

					<entity>
						<type>owl:Class</type>

						<instance_generator name="CapitalizeWords">

							<arg name="prefix" type="constant">
								http://ontology.holywells.link/ontology/
							</arg>

							<arg name="text" type="xpath">
								*[local-name()='binding'
								and @name='statedInInstanceOfLabel']
								/*[local-name()='literal']/text()
							</arg>
						</instance_generator>

						<additional>
							<relationship>rdfs:subClassOf</relationship>

							<entity>
								<type>owl:Class</type>

								<instance_generator name="CapitalizeWords">

									<arg name="prefix" type="constant">
										http://www.cidoc-crm.org/cidoc-crm/
									</arg>

									<arg name="text" type="constant">
										E73_Information_Object
									</arg>
								</instance_generator>
							</entity>
						</additional>

					</entity>
				</target_node>
			</domain>
		</mapping>


	</mappings>
</x3ml>