<?xml version="1.0" encoding="UTF-8"?>

<x3ml version="1.0" source_type="xpath">

    <namespaces>

        <namespace prefix="hw"
            uri="http://ontology.holywells.link/ontology/" />

        <namespace prefix="crm"
            uri="http://www.cidoc-crm.org/cidoc-crm/" />

        <namespace prefix="owl"
            uri="http://www.w3.org/2002/07/owl#" />

        <namespace prefix="rdf"
            uri="http://www.w3.org/1999/02/22-rdf-syntax-ns#" />

        <namespace prefix="rdfs"
            uri="http://www.w3.org/2000/01/rdf-schema#" />

        <namespace prefix="skos"
            uri="http://www.w3.org/2004/02/skos/core#" />

        <namespace prefix="schema"
            uri="http://schema.org/" />

        <namespace prefix="xsd"
            uri="http://www.w3.org/2001/XMLSchema#" />

    </namespaces>

    <mappings>


        <!-- ===================================================== -->
        <!-- Website / URL -> E73 Information Object -->
        <!-- E73 -> P67_refers_to -> Holy Well -->
        <!-- E73 -> P1_is_identified_by -> E42_Identifier -->
        <!-- E42 -> P190 -> xsd:string -->
        <!-- ===================================================== -->

        <mapping>

            <domain>

                <source_node>
                    //*[local-name()='binding' and @name='subject']
                </source_node>

                <target_node>

                    <entity>

                        <type>crm:E73_Information_Object</type>

                        <!-- The website is identified by its URL. TextualContent makes this
                        deterministic: the same URL -> the same E73 URI. -->
                        <instance_generator name="TextualContent">

                            <arg name="text" type="xpath">
                                concat("Website_",
                                ../*[local-name()='binding' and @name='object']
                                /*[local-name()='uri']/text())
                            </arg>

                        </instance_generator>

                        <label_generator name="SimpleLabel">
                            <arg name="label" type="xpath">
                                concat("Website_",
                                ../*[local-name()='binding' and @name='object']
                                /*[local-name()='uri']/text()),
                                &quot;'&quot;
                            </arg>

                            <arg name="language" type="constant">en</arg>

                        </label_generator>


                        <!-- ================================================= -->
                        <!-- E73 -> P67_refers_to -> Holy Well -->
                        <!-- ================================================= -->

                        <additional>

                            <relationship>crm:P67_refers_to</relationship>

                            <entity>

                                <type>owl:NamedIndividual</type>

                                <!-- Use the Wikidata subject URI directly. Both input records
                                therefore point to the same Holy Well. -->
                                <instance_generator name="URIorUUID">

                                    <arg name="text" type="xpath">
                                        *[local-name()='uri']/text()
                                    </arg>

                                </instance_generator>

                            </entity>

                        </additional>


                        <!-- ================================================= -->
                        <!-- E73 -> P1_is_identified_by -> E42_Identifier -->
                        <!-- ================================================= -->

                        <additional>

                            <relationship>crm:P1_is_identified_by</relationship>

                            <entity>

                                <type>crm:E42_Identifier</type>

                                <!-- Deterministic identifier URI. We deliberately prepend
                                "identifier:" so that this URI is different from the E73 URI
                                generated from the bare URL. -->
                                <instance_generator name="TextualContent">

                                    <arg name="text" type="xpath">


                                        ../*[local-name()='binding'
                                        and @name='object']
                                        /*[local-name()='uri']/text()

                                    </arg>

                                </instance_generator>

                                <label_generator name="SimpleLabel">
                                    <arg name="label" type="xpath">
                                        concat("URL_Identifier_",
                                        ../*[local-name()='binding' and @name='object']
                                        /*[local-name()='uri']/text()),
                                        &quot;'&quot;
                                    </arg>

                                    <arg name="language" type="constant">en</arg>

                                </label_generator>


                                <!-- ========================================= -->
                                <!-- E42 -> P190 -> xsd:string -->
                                <!-- ========================================= -->

                                <additional>

                                    <relationship>crm:P190_has_symbolic_content</relationship>

                                    <entity>

                                        <type>xsd:string</type>

                                        <instance_generator name="Literal">

                                            <arg name="text" type="xpath">
                                                ../*[local-name()='binding'
                                                and @name='object']
                                                /*[local-name()='uri']/text()
                                            </arg>

                                        </instance_generator>

                                    </entity>

                                </additional>

                            </entity>

                        </additional>

                    </entity>

                </target_node>

            </domain>

        </mapping>

    </mappings>

</x3ml>