<?xml version="1.0" encoding="UTF-8"?>

<x3ml version="1.0" source_type="xpath">

    <namespaces>

        <namespace prefix="hw"
            uri="http://ontology.holywells.link/ontology/" />

        <namespace prefix="crm"
            uri="http://www.cidoc-crm.org/cidoc-crm/" />

        <namespace prefix="owl"
            uri="http://www.w3.org/2002/07/owl#" />

        <namespace prefix="rdf"
            uri="http://www.w3.org/1999/02/22-rdf-syntax-ns#" />

        <namespace prefix="rdfs"
            uri="http://www.w3.org/2000/01/rdf-schema#" />

        <namespace prefix="skos"
            uri="http://www.w3.org/2004/02/skos/core#" />

        <namespace prefix="schema"
            uri="http://schema.org/" />

        <namespace prefix="xsd"
            uri="http://www.w3.org/2001/XMLSchema#" />

    </namespaces>

    <mappings>
        <!-- ===================================================== -->
        <!-- holy well -> P1_is_identified_by E41_Appellation -->
        <!-- E41_Appellation P67_refers_to a person/location/whatever is stated in wikidata -->
        <!-- ===================================================== -->
        <mapping>

            <domain>

                <source_node>
                    //*[local-name()='binding' and @name='object']
                </source_node>

                <target_node>

                    <entity>

                        <type>owl:NamedIndividual</type>

                        <instance_generator name="URIorUUID">
                            <arg name="text" type="xpath">
                                ../*[local-name()='binding' and
                                @name='subject']/*[local-name()='uri']/text()
                            </arg>
                        </instance_generator>

                        <!-- holy well -> P1_is_identified_by E41_Appellation -->
                        <additional>

                            <relationship>crm:P1_is_identified_by</relationship>

                            <entity>

                                <type>crm:E41_Appellation</type>
                                <instance_generator name="URIorUUID">
                                    <arg name="text" type="xpath">
                                        concat(
                                        'http://ontology.holywells.link/ontology/E41_Appellation_',
                                        substring-after(
                                        ../*[local-name()='binding' and @name='subject']
                                        /*[local-name()='uri']/text(),
                                        'http://www.wikidata.org/entity/'),
                                        '_',
                                        substring-after(
                                        ../*[local-name()='binding' and @name='object']
                                        /*[local-name()='uri']/text(),
                                        'http://www.wikidata.org/entity/'
                                        )
                                        )
                                    </arg>
                                </instance_generator>

                                <!-- E41_Appellation P67_refers-to object -->

                                <additional>

                                    <relationship>crm:P67_refers_to</relationship>

                                    <entity>
                                        <type>owl:NamedIndividual</type>

                                        <instance_generator name="URIorUUID">
                                            <arg name="text" type="xpath">
                                                ../*[local-name()='binding' and @name='object']
                                                /*[local-name()='uri']/text()

                                            </arg>
                                        </instance_generator>

                                        <label_generator name="SimpleLabel">
                                            <arg name="label" type="xpath">
                                                ../*[local-name()='binding' and @name='objectLabel']
                                                /*[local-name()='literal']/text(),
                                                &quot;'&quot;
                                            </arg>
                                            <arg name="language" type="constant">en</arg>
                                        </label_generator>
                                    </entity>
                                </additional>

                            </entity>

                        </additional>

                    </entity>

                </target_node>

            </domain>

        </mapping>

        <!-- ===================================================== -->
        <!-- the object rdfs:type stated in wikidata -->
        <!-- We can not say if this stated type is a subclass of a cidoc subclass -->
        <!-- ===================================================== -->

        <mapping>
            <domain>
                <source_node>
                    //*[local-name()='binding' and @name='objectInstanceOfLabel']
                </source_node>

                <target_node>
                    <entity>
                        <type>owl:NamedIndividual</type>

                        <instance_generator name="URIorUUID">
                            <arg name="text" type="xpath">
                                ../*[local-name()='binding' and @name='object']
                                /*[local-name()='uri']/text()

                            </arg>
                        </instance_generator>

                        <additional>

                            <relationship>rdf:type</relationship>

                            <entity>
                                <type>owl:Class</type>

                                <instance_generator name="CapitalizeWords">

                                    <arg name="prefix" type="constant">
                                        http://ontology.holywells.link/ontology/
                                    </arg>

                                    <arg name="text" type="xpath">
                                        ./*[local-name()='literal']/text()
                                    </arg>
                                </instance_generator>
                            </entity>
                        </additional>
                    </entity>
                </target_node>
            </domain>
        </mapping>


    </mappings>
</x3ml>