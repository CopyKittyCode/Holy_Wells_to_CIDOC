<?xml version="1.0" encoding="UTF-8"?>

<x3ml version="1.0" source_type="xpath">

    <namespaces>

        <namespace prefix="hw"
            uri="http://ontology.holywells.link/ontology/" />

        <namespace prefix="crm"
            uri="http://www.cidoc-crm.org/cidoc-crm/" />

        <namespace prefix="owl"
            uri="http://www.w3.org/2002/07/owl#" />

        <namespace prefix="rdf"
            uri="http://www.w3.org/1999/02/22-rdf-syntax-ns#" />

        <namespace prefix="rdfs"
            uri="http://www.w3.org/2000/01/rdf-schema#" />

        <namespace prefix="skos"
            uri="http://www.w3.org/2004/02/skos/core#" />

        <namespace prefix="xsd"
            uri="http://www.w3.org/2001/XMLSchema#" />

    </namespaces>


    <mappings>

        <!-- ===================================================== -->
        <!-- E17 -> P41_classified -> Subject -->
        <!-- E17 -> P42_assigned -> E55 Type -->
        <!-- ===================================================== -->

        <mapping>
            <domain>
                <source_node>
                    //*[local-name()='binding' and @name='object']
                </source_node>

                <target_node>
                    <entity>

                        <type>crm:E17_Type_Assignment</type>

                        <instance_generator name="URIorUUID">
                            <!--E17_Type_Assignment_SubjectQcode_PropertyPcode -->

                            <arg name="text" type="xpath"> concat(
                                'http://ontology.holywells.link/ontology/E17_Type_Assignment_',
                                substring-after( ../*[local-name()='binding' and
                                @name='subject']/*[local-name()='uri']/text(),
                                'http://www.wikidata.org/entity/') , '_',
                                substring-after(../*[local-name()='binding' and
                                @name='property']/*[local-name()='uri']/text(),
                                'http://www.wikidata.org/entity/' ) ) </arg>

                        </instance_generator>

                        <!-- E17 -> P41_classified -> Subject -->
                        <additional>
                            <relationship>crm:P41_classified</relationship>

                            <entity>

                                <type>owl:NamedIndividual</type>
                                <instance_generator name="URIorUUID">

                                    <arg name="text" type="xpath">
                                        ../*[local-name()='binding' and @name='subject']
                                        /*[local-name()='uri']/text()
                                    </arg>

                                </instance_generator>

                                <label_generator name="SimpleLabel">
                                    <arg name="label" type="xpath">
                                        ../*[local-name()='binding' and @name='subjectLabel']
                                        /*[local-name()='literal' and @xml:lang ='en']/text(),
                                        &quot;'&quot;
                                    </arg>

                                    <arg name="language" type="constant">en</arg>

                                </label_generator>

                            </entity>
                        </additional>

                        <!-- E17 -> P42_assigned -> E55_Type -->
                        <additional>
                            <relationship>crm:P42_assigned</relationship>
                            <entity>

                                <type>crm:E55_Type</type>


                                <instance_generator name="CapitalizeWords">

                                    <arg name="prefix" type="constant">
                                        http://ontology.holywells.link/ontology/E55_Type_
                                    </arg>

                                    <arg name="text" type="xpath">
                                        ./*[local-name()='literal']/text()
                                    </arg>
                                </instance_generator>



                                <!-- E55_Type -> P1_identified_by-> URL -->
                                <additional>

                                    <relationship>crm:P1_is_identified_by</relationship>

                                    <entity>

                                        <type>crm:E42_Identifier</type>

                                        <!-- Deterministic identifier URI. We deliberately prepend
                                        "identifier:" so that this URI is different from the E73 URI
                                        generated from the bare URL. -->
                                        <instance_generator name="TextualContent">

                                            <arg name="text" type="xpath">

                                                concat('identifier',
                                                ../*[local-name()='binding'
                                                and @name='object']
                                                /*[local-name()='uri']/text())

                                            </arg>

                                        </instance_generator>

                                        <label_generator name="SimpleLabel">
                                            <arg name="label" type="xpath">
                                                concat(
                                                'URL_commons_category_of_',../*[local-name()='binding'
                                                and @name='subjectLabel']
                                                /*[local-name()='literal']/text())
                                            </arg>

                                            <arg name="language" type="constant">en</arg>

                                        </label_generator>


                                        <!-- ========================================= -->
                                        <!-- E42 -> P190 -> xsd:string -->
                                        <!-- ========================================= -->

                                        <additional>

                                            <relationship>crm:P190_has_symbolic_content</relationship>

                                            <entity>

                                                <type>xsd:string</type>


                                                <instance_generator name="CapitalizeWords">

                                                    <arg name="prefix" type="constant">
                                                        https://commons.wikimedia.org/wiki/Category:
                                                    </arg>

                                                    <arg name="text" type="xpath">
                                                        ./*[local-name()='literal']/text()
                                                    </arg>
                                                </instance_generator>


                                            </entity>

                                        </additional>


                                    </entity>
                                </additional>

                            </entity>
                        </additional>
                    </entity>
                </target_node>

            </domain>

        </mapping>

    </mappings>

</x3ml>