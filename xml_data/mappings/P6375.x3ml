<?xml version="1.0" encoding="UTF-8"?>

<x3ml version="1.0" source_type="xpath">

    <namespaces>

        <namespace prefix="hw"
            uri="http://ontology.holywells.link/ontology/" />

        <namespace prefix="crm"
            uri="http://www.cidoc-crm.org/cidoc-crm/" />

        <namespace prefix="owl"
            uri="http://www.w3.org/2002/07/owl#" />

        <namespace prefix="rdf"
            uri="http://www.w3.org/1999/02/22-rdf-syntax-ns#" />

        <namespace prefix="rdfs"
            uri="http://www.w3.org/2000/01/rdf-schema#" />

        <namespace prefix="skos"
            uri="http://www.w3.org/2004/02/skos/core#" />

        <namespace prefix="xsd"
            uri="http://www.w3.org/2001/XMLSchema#" />

    </namespaces>


    <mappings>
        <!--A
        well is described by a string refering to the place it occupies-->

        <!-- ===================================================== -->
        <!-- Holy Well individual -> P55_has_current_location -> E53_Place_WellQcode-->
        <!-- ===================================================== -->

        <mapping>

            <domain>

                <source_node>
                    //*[local-name()='binding' and @name='subject']
                </source_node>

                <target_node>

                    <entity>

                        <type>owl:NamedIndividual</type>

                        <instance_generator name="URIorUUID">

                            <arg name="text" type="xpath">
                                ./*[local-name()='uri']/text()
                            </arg>

                        </instance_generator>


                        <!-- holy well -> P55_has_current_location -> E53_Place_WellQcode -->

                        <additional>

                            <relationship>crm:P55_has_current_location</relationship>

                            <entity>

                                <type>crm:E53_Place</type>

                                <instance_generator name="URIorUUID">
                                    <arg name="text" type="xpath">
                                        concat(
                                        'http://ontology.holywells.link/ontology/E53_Place_',
                                        substring-after( ../*[local-name()='binding' and
                                        @name='subject']/*[local-name()='uri']/text(),
                                        'http://www.wikidata.org/entity/')
                                        )
                                    </arg>

                                </instance_generator>

                            </entity>

                        </additional>


                        <!-- holy well -> P1_is_identified_by -> E41_Appellation -->

                        <additional>

                            <relationship>crm:P1_is_identified_by</relationship>

                            <entity>

                                <type>crm:E41_Appellation</type>

                                <!-- Deterministic identifier number generated from text content-->
                                <instance_generator name="TextualContent">

                                    <arg name="text" type="xpath">
                                        ../*[local-name()='binding'
                                        and @name='object']
                                        /*[local-name()='literal']/text()
                                    </arg>

                                </instance_generator>

                                <!-- E41 -> P190_has_symbolic_content -> E62_String -->

                                <additional>

                                    <relationship>crm:P190_has_symbolic_content</relationship>

                                    <entity>

                                        <type>crm:E62_String</type>

                                        <instance_generator name="TypedLiteralGenerator">

                                            <arg name="text" type="xpath">
                                                ../*[local-name()='binding'
                                                and @name='object']
                                                /*[local-name()='literal']/text()
                                            </arg>

                                        </instance_generator>

                                    </entity>

                                </additional>

                            </entity>

                        </additional>

                    </entity>

                </target_node>

            </domain>

        </mapping>



        <!-- ===================================================== -->
        <!-- statedIn document -> P70_documents -> E41_Appellation -->
        <!-- statedIn is optional-->
        <!-- ===================================================== -->

        <mapping>

            <domain>

                <source_node>
                    //*[local-name()='binding' and @name='statedIn']
                </source_node>

                <target_node>

                    <entity>

                        <type>owl:NamedIndividual</type>

                        <instance_generator name="URIorUUID">

                            <arg name="text" type="xpath">
                                ./*[local-name()='uri']/text()
                            </arg>

                        </instance_generator>


                        <label_generator name="SimpleLabel">

                            <arg name="label" type="xpath">
                                ../*[local-name()='binding' and
                                @name='statedInLabel']/*[local-name()='literal'
                                and @xml:lang='en']/text(),
                                &quot;'&quot;
                            </arg>

                            <arg name="language" type="constant">en</arg>

                        </label_generator>


                        <!-- document -> P67_refers_to -> E41_Appellation -->

                        <additional>

                            <relationship>crm:P67_refers_to</relationship>

                            <entity>

                                <type>crm:E41_Appellation</type>

                                <!-- Deterministic identifier number generated from text content-->
                                <instance_generator name="TextualContent">

                                    <arg name="text" type="xpath">
                                        ../*[local-name()='binding'
                                        and @name='object']
                                        /*[local-name()='literal']/text()
                                    </arg>

                                </instance_generator>
                                <label_generator name="SimpleLabel">
                                    <arg name="label" type="xpath">

                                        concat(
                                        'Location_Description_Of_',
                                        substring-after(
                                        ../*[local-name()='binding' and @name='subject']
                                        /*[local-name()='uri']/text(),
                                        'http://www.wikidata.org/entity/')
                                        )
                                    </arg>

                                    <arg name="language" type="constant">en</arg>

                                </label_generator>


                            </entity>

                        </additional>

                    </entity>

                </target_node>

            </domain>

        </mapping>



        <!-- ===================================================== -->
        <!-- wikidata document rdfs type stated by wikidata -->
        <!-- ===================================================== -->

        <mapping>
            <domain>
                <source_node>
                    //*[local-name()='binding' and @name='statedInInstanceOfLabel']
                </source_node>

                <target_node>

                    <entity>

                        <type>owl:NamedIndividual</type>

                        <instance_generator name="URIorUUID">
                            <arg name="text" type="xpath">
                                ../*[local-name()='binding' and
                                @name='statedIn']/*[local-name()='uri']/text()
                            </arg>
                        </instance_generator>

                        <additional>

                            <relationship>rdf:type</relationship>

                            <entity>
                                <type>owl:Class</type>

                                <instance_generator name="CapitalizeWords">

                                    <arg name="prefix" type="constant">
                                        http://ontology.holywells.link/ontology/
                                    </arg>

                                    <arg name="text" type="xpath">
                                        ./*[local-name()='literal']/text()
                                    </arg>
                                </instance_generator>
                            </entity>
                        </additional>
                    </entity>
                </target_node>
            </domain>
        </mapping>

        <!-- ===================================================== -->
        <!-- types stated by wikidata rdf:subclass E73_Information_object -->
        <!-- ===================================================== -->

        <mapping>
            <domain>
                <source_node>
                    //*[local-name()='result'][
                    *[local-name()='binding' and @name='statedInInstanceOfLabel']
                    ]
                </source_node>

                <target_node>

                    <entity>
                        <type>owl:Class</type>

                        <instance_generator name="CapitalizeWords">

                            <arg name="prefix" type="constant">
                                http://ontology.holywells.link/ontology/
                            </arg>

                            <arg name="text" type="xpath">
                                *[local-name()='binding'
                                and @name='statedInInstanceOfLabel']
                                /*[local-name()='literal']/text()
                            </arg>
                        </instance_generator>

                        <additional>
                            <relationship>rdfs:subClassOf</relationship>

                            <entity>
                                <type>owl:Class</type>

                                <instance_generator name="CapitalizeWords">

                                    <arg name="prefix" type="constant">
                                        http://www.cidoc-crm.org/cidoc-crm/
                                    </arg>

                                    <arg name="text" type="constant">
                                        E73_Information_Object
                                    </arg>
                                </instance_generator>
                            </entity>
                        </additional>

                    </entity>
                </target_node>
            </domain>
        </mapping>

    </mappings>

</x3ml>